# Database
DATABASE_URL=postgres://tickr:tickr@localhost:5432/tickr

# Redis
REDIS_URL=redis://localhost:6379

# Massive (worker only — backfill + post-close session updates)
# Polygon-compatible aggregates: GET /v2/aggs/ticker/.../range/{mult}/{span}/...
# Free tier serves minute/hour bars for the trailing ~2 years (rate-limited).
MASSIVE_API_KEY=

# Bar granularity, shared by backfill and the session updater (default 15-minute).
# span ∈ second|minute|hour|day|week|month. Finer spans auto-shrink request
# windows to stay under the 50k-result cap.
# BACKFILL_MULTIPLIER=15
# BACKFILL_TIMESPAN=minute

# Universe seeding (`pnpm backfill` / `pnpm metadata`). The S&P 500 constituent
# list is sourced live from Wikipedia and reconciled into universe_symbol: new
# members are added, returning members reactivated, departed members retired
# (removed_at set — never deleted). A single reconcile retires at most this
# fraction of the active universe; above it, retirements are skipped (a divergent
# source fails safe). Additions are never capped. The first run against the stale
# bundled CSV diverges ~13%, so run it once with a higher value to clear the
# backlog (e.g. UNIVERSE_MAX_DEPARTURE_FRACTION=0.2); steady-state quarterly
# churn is well under the 0.1 default.
# UNIVERSE_MAX_DEPARTURE_FRACTION=0.1

# Ticker metadata + branding refresh (`pnpm metadata`). Sources company fields
# and downloads logo/icon images from the Massive reference API into Postgres
# (symbol_metadata + symbol_branding). Idempotent: only missing/aged-out rows
# are fetched. Shares the same MASSIVE_API_KEY and rate-limit bucket as backfill.
# METADATA_TTL_DAYS=30          # re-fetch artifacts older than this
# METADATA_REFRESH_ALL=false    # true = refetch every symbol regardless of age
# METADATA_DOWNLOAD_ICONS=true  # false = logos only (≈halves request count)
# METADATA_CONCURRENCY=4

# OAuth providers (api only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Session signing (api only) — generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=

# Admin bootstrap: comma-separated provider:subject pairs that grant admin on first login
# e.g. ADMIN_BOOTSTRAP=google:1234567890,github:42
ADMIN_BOOTSTRAP=

# Public base URL — used for OAuth redirect URIs
# Local dev: https://local.tickr.keithheacock.com  |  Production: https://tickr.keithheacock.com
PUBLIC_BASE_URL=https://local.tickr.keithheacock.com

# Logging
LOG_LEVEL=info

# Postgres credentials consumed by the postgres container
POSTGRES_USER=tickr
POSTGRES_PASSWORD=tickr
POSTGRES_DB=tickr
