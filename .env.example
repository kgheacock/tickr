# Database
DATABASE_URL=postgres://tickr:tickr@localhost:5432/tickr

# Redis
REDIS_URL=redis://localhost:6379

# Finnhub (worker only — daily price updates via GET /quote)
FINNHUB_API_KEY=
# Webhook signing secret — Finnhub signs webhook payloads with this
FINNHUB_WEBHOOK_SECRET=

# Massive (worker only — bootstrap backfill)
# REST fallback: per-ticker GET /v2/aggs/ticker/... (rate-limited)
MASSIVE_API_KEY=

# Kaggle (one-time bootstrap — run scripts/kaggle-backfill.ts before the Massive backfill job)
KAGGLE_USERNAME=
KAGGLE_API_KEY=

# After running scripts/kaggle-backfill.ts, set this to fill only the Kaggle→present gap
# BACKFILL_START_DATE=2024-07-06

# OAuth providers (api only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Session signing (api only) — generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=

# Admin bootstrap: comma-separated provider:subject pairs that grant admin on first login
# e.g. ADMIN_BOOTSTRAP=google:1234567890,github:42
ADMIN_BOOTSTRAP=

# Public base URL — used for OAuth redirect URIs
# Local dev: https://local.tickr.keithheacock.com  |  Production: https://tickr.keithheacock.com
PUBLIC_BASE_URL=https://local.tickr.keithheacock.com

# Logging
LOG_LEVEL=info

# Postgres credentials consumed by the postgres container
POSTGRES_USER=tickr
POSTGRES_PASSWORD=tickr
POSTGRES_DB=tickr
