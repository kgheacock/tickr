{
  "name": "@tickr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:universe": "tsx src/db/seed-universe.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tickr/shared-types": "*",
    "node-pg-migrate": "^7.7.0",
    "pg": "^8.13.0",
    "tsx": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.0.0",
    "@types/pg": "^8.11.0",
    "testcontainers": "^10.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
