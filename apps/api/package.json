{
  "name": "@tickr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:universe": "tsx src/db/seed-universe.ts",
    "backfill": "node --env-file-if-exists=../../.env --import tsx src/jobs/run-backfill.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@tickr/shared-types": "workspace:*",
    "decimal.js": "^10.6.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.0",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "openid-client": "^6.8.4",
    "p-limit": "^3.1.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "tsx": "^4.7.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.12",
    "testcontainers": "^12.0.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
