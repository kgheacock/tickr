# Production Caddyfile. Differs from the dev Caddyfile only in the site address
# and that it serves the prebuilt SPA from /srv (baked into the web image) — dev
# proxies the Vite dev server instead. Caddy obtains and renews real TLS certs
# from Let's Encrypt automatically on first request.
{
	# ACME account contact; Let's Encrypt uses it for expiry notices.
	email ops@keithheacock.com
	# No admin endpoint published in prod (the dev overlay exposes :2019 locally).
	admin off
}

# Redirect the www host to the apex.
www.tickr.keithheacock.com {
	redir https://tickr.keithheacock.com{uri} permanent
}

tickr.keithheacock.com {
	encode zstd gzip

	# HSTS: 1 year, include subdomains, preload-eligible.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /ws/* {
		reverse_proxy api:3000
	}

	# SPA: serve static assets, falling back to index.html for client routes.
	handle {
		root * /srv

		# Cache busting. Vite emits content-hashed bundles under /assets/
		# (e.g. index-yPiskd7U.js) — the URL changes whenever the content
		# does, so they're safe to cache forever. index.html (and the SPA
		# fallback for any client route) must NOT be cached, or browsers keep
		# loading an old document that points at stale asset URLs. no-cache
		# still allows a cheap ETag revalidation (304); it just forbids serving
		# from cache without checking first. The matchers are mutually exclusive
		# so exactly one applies, evaluated against the original request path
		# (before the try_files fallback rewrite).
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
