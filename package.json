{
  "name": "tickr",
  "private": true,
  "version": "0.0.0",
  "description": "tickr — perpetual stock-trading leaderboard",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install || true",
    "typecheck": "npm run -ws --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "./scripts/dev-up.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "lefthook": "^1.6.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
