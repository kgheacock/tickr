{
  "name": "tickr",
  "private": true,
  "version": "0.1.0",
  "description": "tickr — perpetual stock-trading leaderboard",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "./scripts/dev-up.sh",
    "db:snapshot": "./scripts/db-snapshot.sh",
    "db:restore": "./scripts/db-restore.sh",
    "gen:types": "openapi-typescript packages/shared-types/openapi.yaml -o packages/shared-types/src/openapi.gen.ts",
    "gen:massive": "openapi-typescript schema/massive.com/openapi.json -o apps/api/src/massive/massive.gen.ts && prettier --write apps/api/src/massive/massive.gen.ts",
    "gen:finnhub": "openapi-typescript schema/finnhub.io/openapi.json -o apps/api/src/finnhub/finnhub.gen.ts && prettier --write apps/api/src/finnhub/finnhub.gen.ts",
    "lint:openapi": "redocly lint packages/shared-types/openapi.yaml",
    "data-audit": "tsx scripts/data-audit.ts",
    "backfill": "pnpm --filter @tickr/api run backfill",
    "metadata": "pnpm --filter @tickr/api run metadata",
    "classify": "pnpm --filter @tickr/api run classify"
  },
  "devDependencies": {
    "@redocly/cli": "^2.31.5",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "lefthook": "^1.6.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
